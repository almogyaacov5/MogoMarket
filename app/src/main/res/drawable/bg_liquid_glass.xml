<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- בסיס זכוכית בהיר ושקוף -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="40dp"/>
            <solid android:color="#D9F0F4F8"/>
        </shape>
    </item>

    <!-- השתקפות עליונה -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="40dp"/>
            <gradient
                android:angle="270"
                android:startColor="#BFFFFFFF"
                android:centerColor="#55FFFFFF"
                android:endColor="#10FFFFFF"/>
        </shape>
    </item>

    <!-- גוון כחול -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="40dp"/>
            <gradient
                android:angle="0"
                android:startColor="#184DA3FF"
                android:centerColor="#06FFFFFF"
                android:endColor="#184DA3FF"/>
        </shape>
    </item>

    <!-- הברקה תחתונה -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="40dp"/>
            <gradient
                android:angle="90"
                android:startColor="#00FFFFFF"
                android:centerColor="#12FFFFFF"
                android:endColor="#55FFFFFF"/>
        </shape>
    </item>

    <!-- מסגרת חיצונית -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="40dp"/>
            <stroke
                android:width="1dp"
                android:color="#99FFFFFF"/>
        </shape>
    </item>

</layer-list>
