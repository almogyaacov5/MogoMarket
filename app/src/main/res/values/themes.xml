<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base Theme -->
    <style name="Base.Theme.MogoMarket" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/bg_card</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorSurface">@color/bg_secondary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorBackground">@color/bg_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorError">@color/loss</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="materialCardViewStyle">@style/CardStyle</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="bottomNavigationStyle">@style/BottomNavStyle</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.MogoMarket.Dialog</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.MogoMarket.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MogoMarket.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.MogoMarket.BottomSheetDialog</item>
        <item name="popupMenuStyle">@style/MogoMarketPopupMenu</item>
        <item name="android:popupMenuStyle">@style/MogoMarketPopupMenu</item>
        <item name="android:datePickerDialogTheme">@style/ThemeOverlay.MogoMarket.Dialog</item>
        <item name="android:timePickerDialogTheme">@style/ThemeOverlay.MogoMarket.Dialog</item>
    </style>

    <style name="Theme.MogoMarket" parent="Base.Theme.MogoMarket" />
    <style name="Theme.Chart" parent="Base.Theme.MogoMarket" />
    <style name="Base.Theme.Chart" parent="Base.Theme.MogoMarket" />

    <!-- ✅ חדש -->
    <style name="Theme.Splash" parent="Theme.MogoMarket">
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="ThemeOverlay.MogoMarket.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurface">@color/bg_secondary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorBackground">@color/bg_secondary</item>
        <item name="android:windowBackground">@drawable/bg_dialog_glass</item>
    </style>

    <style name="ThemeOverlay.MogoMarket.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurface">@color/bg_secondary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="MogoMarketPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_dialog_glass</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Material Card -->
    <style name="CardStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="strokeColor">@color/colorBorder</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="BottomNavStyle" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">?attr/colorSurface</item>
        <item name="elevation">8dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemActiveIndicatorStyle">@style/BottomNavIndicatorStyle</item>
    </style>

    <!-- Bottom Nav Active Indicator - hidden -->
    <style name="BottomNavIndicatorStyle" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
    </style>

    <style name="ChartTimeframeButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textColor">@color/chart_tf_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:includeFontPadding">true</item>
        <item name="android:backgroundTint">@color/chart_tf_unselected</item>
        <item name="cornerRadius">28dp</item>
        <item name="strokeColor">@color/chart_gold</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Primary Button -->
    <style name="ButtonStyle" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Outlined Button -->
    <style name="ButtonOutlinedStyle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Gain Text -->
    <style name="TextGain">
        <item name="android:textColor">@color/gain</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Loss Text -->
    <style name="TextLoss">
        <item name="android:textColor">@color/loss</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Theme Toggle -->
    <style name="ThemeToggleButton" parent="Widget.Material3.Button.IconButton">
        <item name="backgroundTint">@color/theme_toggle_bg</item>
        <item name="iconTint">@color/theme_toggle_icon</item>
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="cornerRadius">22dp</item>
    </style>

</resources>