<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chartRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ChartFragment">

    <!-- Hidden IDs kept for Java backward-compat (not visible) -->
    <View
        android:id="@+id/searchSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/timeFrameText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text=""
        android:visibility="gone" />

    <!-- Hidden backward-compat IDs -->
    <Button
        android:id="@+id/btnChartThemeToggle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:minWidth="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSettings"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:minWidth="0dp"
        android:minHeight="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExpandChart"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:contentDescription="Fullscreen" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelectTimeFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTF1D"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTF1W"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTF1M"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTF3M"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTF1Y"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- ===== HEADER CARD ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- Ticker label (text only, LEFT) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="14dp">

                <TextView
                    android:id="@+id/tickerLabelTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPY"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFE6EDF3"
                    android:letterSpacing="0.03" />

                <!-- Hidden tickerText kept for backward compat -->
                <TextView
                    android:id="@+id/tickerText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Price + Change (RIGHT) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/priceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:letterSpacing="0.02" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/changeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="--"
                        android:textSize="11sp"
                        android:textColor="@color/gain"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:id="@+id/currentPriceDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== CHART AREA ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/chartContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="0dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="2dp">

            <com.github.mikephil.charting.charts.CandleStickChart
                android:id="@+id/stock_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorSurface" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/line_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorSurface"
                android:visibility="gone" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/portfolio_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorSurface"
                android:visibility="gone" />

            <!-- Crosshair info bar -->
            <LinearLayout
                android:id="@+id/crosshairInfoBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:orientation="horizontal"
                android:background="#CC151C2E"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/crosshairPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#E6EDF3"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  ·  "
                    android:textColor="#8B98A5"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/crosshairDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#8B98A5"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Exit fullscreen button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExitFullscreen"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:backgroundTint="#AA151C2E"
                android:contentDescription="Exit fullscreen"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:visibility="gone"
                app:icon="@drawable/baseline_fullscreen_exit_24"
                app:iconTint="?attr/colorOnSurface" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== CONTROLS ROW (BOTTOM) ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/controlsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp"
            android:layoutDirection="ltr">

            <!-- Ticker button (opens search sheet) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTickerSelect"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1.2"
                android:text="SPY"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textAllCaps="false" />

            <!-- Timeframe picker button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTimeframePicker"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="1D"
                android:textSize="12sp"
                android:textAllCaps="false"
                app:iconSize="14dp"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChartRefresh"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:contentDescription="Refresh"
                app:icon="@drawable/baseline_refresh_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleChart"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Line"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAIAnalysis"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_weight="0.8"
                android:layout_height="40dp"
                android:text="AI"
                android:backgroundTint="@color/gain"
                android:layout_marginStart="4dp"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/progressAI"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Hidden bottom bar kept for backward compat -->
    <View
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
