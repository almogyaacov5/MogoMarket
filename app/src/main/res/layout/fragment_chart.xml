<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chartRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    tools:context=".MainActivity">

    <!-- ===== HEADER CARD ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Ticker Button (replaces static tickerText) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTickerSelect"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="SPY"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:minWidth="0dp" />

                <!-- Hidden tickerText kept for backward compat -->
                <TextView
                    android:id="@+id/tickerText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettings"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Settings"
                    app:icon="@drawable/ic_nav_settings"
                    app:iconTint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/priceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:letterSpacing="0.02"/>
            </LinearLayout>

            <!-- change + percent row — minimal top padding so % is higher -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/changeText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="--"
                    android:textSize="14sp"
                    android:textColor="@color/gain"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"/>

                <TextView
                    android:id="@+id/currentPriceDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== CHART AREA (weight=1 to fill space) ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/chartContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp">

            <com.github.mikephil.charting.charts.CandleStickChart
                android:id="@+id/stock_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorSurface" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/line_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorSurface"
                android:visibility="gone" />

            <!-- Chart theme toggle — top-left corner of the chart -->
            <Button
                android:id="@+id/btnChartThemeToggle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:text="🌙 Dark Chart"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:backgroundTint="#AA151C2E"
                android:textColor="#FFFFFF" />

            <!-- Exit fullscreen button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExitFullscreen"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:backgroundTint="#AA151C2E"
                android:contentDescription="Exit fullscreen"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:visibility="gone"
                app:icon="@drawable/baseline_fullscreen_exit_24"
                app:iconTint="?attr/colorOnSurface" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== BOTTOM INFO BAR ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="6dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/timeFrameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Timeframe: --"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H: --"
                android:textSize="12sp"
                android:textColor="@color/gain"
                android:layout_marginEnd="12dp"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="L: --"
                android:textSize="12sp"
                android:textColor="@color/loss"
                android:letterSpacing="0.02" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== CONTROLS ROW (BOTTOM) ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/controlsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:layoutDirection="ltr">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChartRefresh"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Refresh"
                app:icon="@drawable/baseline_refresh_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectTimeFrame"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:text="Timefr"
                android:layout_marginStart="6dp"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleChart"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="0.8"
                android:text="Line"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPortfolioChart"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_weight="0.9"
                android:layout_height="40dp"
                android:text="📊 Portfolio"
                android:layout_marginStart="6dp"
                android:textAllCaps="false"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAIAnalysis"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_weight="0.9"
                android:layout_height="40dp"
                android:text="AI ✦"
                android:backgroundTint="@color/gain"
                android:layout_marginStart="6dp"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExpandChart"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Fullscreen"
                android:layout_marginStart="6dp"
                app:icon="@drawable/baseline_fullscreen_24"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <ProgressBar
                android:id="@+id/progressAI"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
