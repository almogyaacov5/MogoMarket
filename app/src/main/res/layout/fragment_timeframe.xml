<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:paddingTop="8dp"
    android:paddingBottom="24dp"
    android:paddingHorizontal="20dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_handle_bar" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:background="@drawable/bg_icon_circle_blue">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="בחר טווח זמן"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#0D1117"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <!-- Timeframe Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="3"
        android:useDefaultMargins="false">

        <!-- Row 1 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1min"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="5dp"
            android:text="1 דקה"
            android:textSize="13sp"
            android:textColor="#0D1117"
            app:cornerRadius="14dp"
            app:strokeColor="#CBD5E0"
            app:strokeWidth="1dp"
            app:backgroundTint="#FFFFFF"
            android:tag="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn5min"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="5dp"
            android:text="5 דקות"
            android:textSize="13sp"
            android:textColor="#0D1117"
            app:cornerRadius="14dp"
            app:strokeColor="#CBD5E0"
            app:strokeWidth="1dp"
            app:backgroundTint="#FFFFFF"
            android:tag="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn15min"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="5dp"
            android:text="15 דקות"
            android:textSize="13sp"
            android:textColor="#0D1117"
            app:cornerRadius="14dp"
            app:strokeColor="#CBD5E0"
            app:strokeWidth="1dp"
            app:backgroundTint="#FFFFFF"
            android:tag="false" />

        <!-- Row 2 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn65min"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="5dp"
            android:text="65 דקות"
            android:textSize="13sp"
            android:textColor="#0D1117"
            app:cornerRadius="14dp"
            app:strokeColor="#CBD5E0"
            app:strokeWidth="1dp"
            app:backgroundTint="#FFFFFF"
            android:tag="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1day"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="5dp"
            android:text="יום"
            android:textSize="13sp"
            android:textColor="#0D1117"
            app:cornerRadius="14dp"
            app:strokeColor="#CBD5E0"
            app:strokeWidth="1dp"
            app:backgroundTint="#FFFFFF"
            android:tag="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1week"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="5dp"
            android:text="שבוע"
            android:textSize="13sp"
            android:textColor="#0D1117"
            app:cornerRadius="14dp"
            app:strokeColor="#CBD5E0"
            app:strokeWidth="1dp"
            app:backgroundTint="#FFFFFF"
            android:tag="false" />

        <!-- Row 3 - month full width -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1month"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_columnSpan="3"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="5dp"
            android:text="חודש"
            android:textSize="13sp"
            android:textColor="#0D1117"
            app:cornerRadius="14dp"
            app:strokeColor="#CBD5E0"
            app:strokeWidth="1dp"
            app:backgroundTint="#FFFFFF"
            android:tag="false" />

    </GridLayout>

    <!-- Hidden RadioGroup to keep original logic compatibility -->
    <RadioGroup
        android:id="@+id/radioGroupTimeframes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <RadioButton android:id="@+id/radio1min" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioButton android:id="@+id/radio5min" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioButton android:id="@+id/radio15min" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioButton android:id="@+id/radio65min" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioButton android:id="@+id/radio1day" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioButton android:id="@+id/radio1week" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioButton android:id="@+id/radio1month" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </RadioGroup>

</LinearLayout>
