<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:paddingTop="8dp"
    android:paddingBottom="24dp"
    android:paddingHorizontal="20dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_handle_bar" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:background="@drawable/bg_icon_circle_blue">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#9201;"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="&#1489;&#1495;&#1512; &#1496;&#1493;&#1493;&#1495; &#1494;&#1502;&#1503;"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#0D1117"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <!-- Row 1: 1m, 5m, 15m -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1min"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:text="1m"
            android:textSize="13sp"
            android:textColor="#0D1117"
            app:cornerRadius="14dp"
            app:strokeColor="#CBD5E0"
            app:strokeWidth="1dp"
            app:backgroundTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn5min"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:text="5m"
            android:textSize="13sp"
            android:textColor="#0D1117"
            app:cornerRadius="14dp"
            app:strokeColor="#CBD5E0"
            app:strokeWidth="1dp"
            app:backgroundTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn15min"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text="15m"
            android:textSize="13sp"
            android:textColor="#0D1117"
            app:cornerRadius="14dp"
            app:strokeColor="#CBD5E0"
            app:strokeWidth="1dp"
            app:backgroundTint="#FFFFFF" />

    </LinearLayout>

    <!-- Row 2: 30m, 1H, 4H -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn30min"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:text="30m"
            android:textSize="13sp"
            android:textColor="#0D1117"
            app:cornerRadius="14dp"
            app:strokeColor="#CBD5E0"
            app:strokeWidth="1dp"
            app:backgroundTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1hour"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:text="1H"
            android:textSize="13sp"
            android:textColor="#0D1117"
            app:cornerRadius="14dp"
            app:strokeColor="#CBD5E0"
            app:strokeWidth="1dp"
            app:backgroundTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn4hour"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text="4H"
            android:textSize="13sp"
            android:textColor="#0D1117"
            app:cornerRadius="14dp"
            app:strokeColor="#CBD5E0"
            app:strokeWidth="1dp"
            app:backgroundTint="#FFFFFF" />

    </LinearLayout>

    <!-- Row 3: 1D, 1W, 1M -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1day"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:text="1D"
            android:textSize="13sp"
            android:textColor="#0D1117"
            app:cornerRadius="14dp"
            app:strokeColor="#CBD5E0"
            app:strokeWidth="1dp"
            app:backgroundTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1week"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:text="1W"
            android:textSize="13sp"
            android:textColor="#0D1117"
            app:cornerRadius="14dp"
            app:strokeColor="#CBD5E0"
            app:strokeWidth="1dp"
            app:backgroundTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1month"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text="1M"
            android:textSize="13sp"
            android:textColor="#0D1117"
            app:cornerRadius="14dp"
            app:strokeColor="#CBD5E0"
            app:strokeWidth="1dp"
            app:backgroundTint="#FFFFFF" />

    </LinearLayout>

    <!-- Hidden RadioGroup for backward compat -->
    <RadioGroup
        android:id="@+id/radioGroupTimeframes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <RadioButton android:id="@+id/radio1min" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioButton android:id="@+id/radio5min" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioButton android:id="@+id/radio15min" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioButton android:id="@+id/radio65min" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioButton android:id="@+id/radio1day" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioButton android:id="@+id/radio1week" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioButton android:id="@+id/radio1month" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </RadioGroup>

</LinearLayout>
