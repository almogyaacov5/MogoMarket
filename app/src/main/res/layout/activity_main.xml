
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="84dp">

        <View
            android:id="@+id/navigation_dock_background"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/bg_liquid_glass"
            android:elevation="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/nav_chart_button"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:contentDescription="@string/nav_chart_label"
                android:tag="@id/nav_chart"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_chart"
                    app:tint="@color/navigation_icon_tint" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/nav_chart_label"
                    android:textColor="@color/navigation_icon_tint"
                    android:textSize="9sp"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_portfolio_button"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:contentDescription="@string/nav_portfolio_label"
                android:tag="@id/nav_portfolio"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_portfolio"
                    app:tint="@color/navigation_icon_tint" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/nav_portfolio_label"
                    android:textColor="@color/navigation_icon_tint"
                    android:textSize="9sp"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_watchlist_button"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:contentDescription="@string/nav_watchlist_label"
                android:tag="@id/nav_stocks"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_watchlist"
                    app:tint="@color/navigation_icon_tint" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/nav_watchlist_label"
                    android:textColor="@color/navigation_icon_tint"
                    android:textSize="9sp"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_trades_button"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:contentDescription="@string/nav_trades_label"
                android:tag="@id/nav_closed_trades"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_closed"
                    app:tint="@color/navigation_icon_tint" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/nav_trades_label"
                    android:textColor="@color/navigation_icon_tint"
                    android:textSize="9sp"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_simulator_button"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:contentDescription="@string/nav_simulator_label"
                android:tag="@id/nav_simulator"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_simulator"
                    app:tint="@color/navigation_icon_tint" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/nav_simulator_label"
                    android:textColor="@color/navigation_icon_tint"
                    android:textSize="9sp"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_settings_button"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:contentDescription="@string/nav_settings_label"
                android:tag="@id/nav_settings"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_settings"
                    app:tint="@color/navigation_icon_tint" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/nav_settings_label"
                    android:textColor="@color/navigation_icon_tint"
                    android:textSize="9sp"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
